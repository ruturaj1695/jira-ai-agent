APP_ENV=development
LOG_LEVEL=INFO

# Company-provided RTB Ollama server. Connect to GlobalProtect VPN first.
OLLAMA_BASE_URL=
LLM_PROVIDER=ollama
LLM_MODEL=llama3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:latest

# Optional cloud fallback for local experimentation.
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_BOARD_ID=
JIRA_STORY_POINTS_FIELD=
# Keep TLS verification enabled. For a company CA, prefer JIRA_CA_BUNDLE over disabling verification.
JIRA_SSL_VERIFY=true
JIRA_CA_BUNDLE=
JIRA_MAX_RESULTS=50
CHROMA_PERSIST_DIRECTORY=./chroma_db
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rtb-jira-ai-agent
